msgid_plural "%d elements"
msgstr[0] "%d élément"
msgstr[1] "%d éléments"

#: assets/js/editor.js:161
msgid "Why and how to fix"
msgstr "Pourquoi et comment corriger"

#: assets/js/editor.js:162
