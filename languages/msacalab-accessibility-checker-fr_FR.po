msgstr "Couleur"

#. translators: 1: current text colour, 2: background colour.
#: pro/views/contrast.php:180
#, php-format
msgid "Now %1$s on %2$s"
msgstr "Actuellement %1$s sur %2$s"

#. translators: %s: number of elements.
#: pro/views/contrast.php:188
#, php-format
msgid "Where: %s element"
msgid_plural "Where: %s elements"
msgstr[0] "Où : %s élément"
msgstr[1] "Où : %s éléments"

#: pro/views/contrast.php:202
msgid "Apply selected colours"
msgstr "Appliquer les couleurs sélectionnées"

#: pro/views/contrast.php:203
msgid "Only ticked suggestions are applied."
msgstr "Seules les suggestions cochées sont appliquées."

#. translators: %s: number of elements.
#: pro/views/contrast.php:223
#, php-format
msgid "Approved colours (%s element)"
msgid_plural "Approved colours (%s elements)"
msgstr[0] "Couleurs approuvées (%s élément)"
msgstr[1] "Couleurs approuvées (%s éléments)"

