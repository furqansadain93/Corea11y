msgstr "%1$s : %2$d problèmes"

#. translators: 1: page name, 2: error message.
#: assets/js/scanner.js:360
#, js-format
msgid "%1$s: results could not be saved (%2$s)"
msgstr "%1$s : les résultats n’ont pas pu être enregistrés (%2$s)"

#: assets/js/scanner.js:365
msgid "Running site-wide checks and building the report…"
msgstr "Vérifications sur l’ensemble du site et création du rapport…"

#. translators: %d: number of issues found.
#: assets/js/scanner.js:372
#, js-format
