msgstr "Exemple des couleurs actuelles : %s"

#. translators: %s: contrast ratio.
#: pro/views/contrast.php:154
#, php-format
msgid "Contrast %s:1"
msgstr "Contraste %s:1"

#: pro/views/contrast.php:160
