#: includes/class-corea11y-fixes.php:559
#, php-format
msgid "%s player"
msgstr "Reproductor de %s"

#. translators: %s: social network, e.g. "Instagram".
#: includes/class-corea11y-fixes.php:561
#, php-format
msgid "%s post"
msgstr "Publicación de %s"

