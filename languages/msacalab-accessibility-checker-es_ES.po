#: admin/views/alt.php:28 admin/views/alt.php:143 includes/class-corea11y-admin.php:55
msgid "Alt text"
msgstr "Texto alternativo"

#: admin/views/alt.php:29
msgid "Every image on your site that has no alt text, in one place. Type a short description and save: MSACAlab Accessibility Checker adds it to the Media Library and to the pages where the image is already used."
msgstr "Todas las imágenes de su sitio sin texto alternativo, en un solo lugar. Escriba una breve descripción y guarde: MSACAlab Accessibility Checker la añade a la Biblioteca de medios y a las páginas donde ya se usa la imagen."

#. translators: 1: number of images, 2: number of pages and posts.
#: admin/views/alt.php:39
#, php-format
msgid "Alt text saved for %1$d image and added to %2$d pages and posts."
msgid_plural "Alt text saved for %1$d images and added to %2$d pages and posts."
msgstr[0] "Texto alternativo guardado para %1$d imagen y añadido a %2$d páginas y entradas."
msgstr[1] "Texto alternativo guardado para %1$d imágenes y añadido a %2$d páginas y entradas."

#: admin/views/alt.php:42
msgid "This alt text is now part of your site and stays even if MSACAlab Accessibility Checker is removed. Changed pages also have a WordPress revision."
msgstr "Este texto alternativo ya forma parte de su sitio y se mantiene aunque se elimine MSACAlab Accessibility Checker. Las páginas modificadas también tienen una revisión de WordPress."

#: admin/views/alt.php:44 admin/views/fixes.php:73
msgid "Verify with a new audit"
msgstr "Verificar con una nueva auditoría"

#: admin/views/alt.php:50 admin/views/alt.php:184 admin/views/alt.php:198 admin/views/fixes.php:173 admin/views/fixes.php:199 admin/views/partials/fix-card.php:72 admin/views/report.php:68 pro/views/contrast.php:55 pro/views/contrast.php:227 pro/views/contrast.php:244
msgid "Undo"
msgstr "Deshacer"

#: admin/views/alt.php:55
msgid "Nothing to save: type alt text or tick \"Decorative\" for at least one image."
msgstr "Nada que guardar: escriba un texto alternativo o marque «Decorativa» en al menos una imagen."

#: admin/views/alt.php:59
msgid "Undone. The images have their previous alt text again."
msgstr "Deshecho. Las imágenes vuelven a tener su texto alternativo anterior."

#: admin/views/alt.php:59
msgid "That change was already undone."
msgstr "Ese cambio ya se había deshecho."

#: admin/views/alt.php:63
msgid "How to write good alt text"
msgstr "Cómo escribir un buen texto alternativo"

#: admin/views/alt.php:65
msgid "Describe what matters about the image in this context, in a short sentence (usually under 125 characters)."
msgstr "Describa lo importante de la imagen en este contexto, en una frase breve (normalmente menos de 125 caracteres)."

#: admin/views/alt.php:66
msgid "Don't start with \"Image of\" or \"Picture of\": screen readers already say it's an image."
msgstr "No empiece con «Imagen de» o «Foto de»: los lectores de pantalla ya indican que es una imagen."

#: admin/views/alt.php:67
msgid "For a logo, write the company name. For a linked image, say where the link goes."
msgstr "Para un logotipo, escriba el nombre de la empresa. Para una imagen enlazada, indique adónde lleva el enlace."

#: admin/views/alt.php:68
msgid "If the image is only decoration (a background, a divider), tick \"Decorative\" so screen readers skip it."
msgstr "Si la imagen es solo decorativa (un fondo, un separador), marque «Decorativa» para que los lectores de pantalla la omitan."

#: admin/views/alt.php:69
msgid "If the image contains text, include that text."
msgstr "Si la imagen contiene texto, incluya ese texto."

#: admin/views/alt.php:75 admin/views/alt.php:77
msgid "Images used on your site"
msgstr "Imágenes usadas en su sitio"

