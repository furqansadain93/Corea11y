msgid_plural "Great progress: %s fewer issues than last time!"
msgstr[0] "Toller Fortschritt: %s Problem weniger als beim letzten Mal!"
msgstr[1] "Toller Fortschritt: %s Probleme weniger als beim letzten Mal!"

#: admin/views/dashboard.php:87
msgid "The automated checks found no problems in your latest audit. Great work! Use the manual checklist for what software can't check."
msgstr "Die automatischen Prüfungen haben in Ihrer letzten Prüfung keine Probleme gefunden. Sehr gut! Nutzen Sie die manuelle Checkliste für das, was Software nicht prüfen kann."

#. translators: %s: number of issues.
#: admin/views/dashboard.php:90
#, php-format
msgid "Your latest audit found %s issue"
msgid_plural "Your latest audit found %s issues"
msgstr[0] "Ihre letzte Prüfung hat %s Problem gefunden"
msgstr[1] "Ihre letzte Prüfung hat %s Probleme gefunden"

#. translators: 1: date, 2: number of pages.
#: admin/views/dashboard.php:97
#, php-format
msgid "Audited %1$s across %2$s pages."
